APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# DXA (runda 81): SMS. SMS_DRIVER=log scrie mesajele în log (local); smso le trimite prin SMSO. SMSO_SENDER = id-ul expeditorului din contul SMSO.
SMS_DRIVER=log
SMSO_API_KEY=
SMSO_SENDER=
# Opțional: tipul mesajelor (transactional | otp | marketing) și pragul de credit sub care pagina Proprietar avertizează.
SMSO_TYPE=transactional
SMSO_LOW_CREDIT=10
# Limite anti-abuz (opționale): pe destinatar/oră, pe IP/oră, pe zi pentru toată instalarea. 0 = fără limită.
SMS_LIMIT_PER_PHONE=6
SMS_LIMIT_PER_IP=60
SMS_LIMIT_DAILY=1000

VITE_APP_NAME="${APP_NAME}"

# DXA (runda 64): Stripe. Cheia SECRETĂ (sk_test_… / sk_live_…) și secretul webhook-ului (whsec_…). Fără STRIPE_SECRET plata cu cardul rămâne dezactivată.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=ron

# DXA (runda 70): notificări push. Generează cheile cu `php artisan app:push-keys` și lipește-le aici (cheia privată NU se pune în chat sau în zip).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemplu.ro

# Instalare (runda 84): contul de proprietar creat de `php artisan app:install` (opțional; se pot da și ca opțiuni).
# INSTALL_OWNER_PHONE=
# INSTALL_OWNER_PASSWORD=
